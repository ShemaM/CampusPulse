<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registrations_swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- USIU-Africa Editorial Header (Signature Gold Bar + High-Contrast Typography) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.22"
                android:text="USIU-AFRICA"
                android:textColor="@color/gold_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Signature Gold Accent Bar (from Welcome screen) -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:background="@color/usiu_gold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.1"
                android:text="My Schedule"
                android:textColor="@color/usiu_navy"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_my_week_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Your confirmed passes and saved activities for this semester."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Modern Segmented Pill Control (Elastic Pill Switcher) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_segmented_track"
                android:padding="3dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/my_week_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:tabIndicator="@drawable/bg_pill_indicator"
                    app:tabIndicatorAnimationMode="elastic"
                    app:tabIndicatorColor="@color/usiu_navy"
                    app:tabIndicatorFullWidth="true"
                    app:tabIndicatorGravity="stretch"
                    app:tabMode="fixed"
                    app:tabRippleColor="@null"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="@color/usiu_navy" />
            </FrameLayout>
        </LinearLayout>

        <!-- Main Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Events List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/my_week_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:paddingBottom="36dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/view_my_week_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_badge_soft">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="Calendar"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/usiu_navy" />
                </FrameLayout>

                <TextView
                    android:id="@+id/empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="No Confirmed Passes"
                    android:textColor="@color/usiu_navy"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:text="You haven't reserved any event seats yet. Discover upcoming campus workshops, talks, and sports fixtures."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_empty_browse"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginTop="22dp"
                    android:backgroundTint="@color/usiu_gold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Explore Campus Events"
                    android:textAllCaps="false"
                    android:textColor="@color/usiu_navy"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>

            <!-- Guest State -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/registrations_guest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="22dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_badge_soft">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="Scholar"
                            android:src="@drawable/ic_school"
                            app:tint="@color/usiu_navy" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Sign in to Access My Week"
                        android:textColor="@color/usiu_navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="Reserve event seats, receive timetable alerts, and manage your campus schedule in one place."
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_registrations_login"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/usiu_navy"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Sign In"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_registrations_signup"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Create Account"
                            android:textAllCaps="false"
                            android:textColor="@color/usiu_navy"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/usiu_navy"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading View -->
            <ProgressBar
                android:id="@+id/registrations_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/registrations_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/registrations_error_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Couldn't load your registrations."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_registrations_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/usiu_navy"
                    android:text="Try again"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
