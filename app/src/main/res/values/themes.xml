    <style name="TextAppearance.CampusPulse.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Widget.CampusPulse.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#0D3D63</item>
        <item name="android:width">44dp</item>
        <item name="android:height">32dp</item>
    </style>
